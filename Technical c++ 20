Q6. Write a C++ program to input a number and check whether it is positive, negative, or zero using an if-else-if statement.

#include <iostream>
using namespace std;

int main() {
    int num;

    cout << "Enter a number: ";
    cin >> num;

    if (num > 0) {
        cout << "Positive number";
    }
    else if (num < 0) {
        cout << "Negative number";
    }
    else {
        cout << "Zero";
    }

    return 0;
}
