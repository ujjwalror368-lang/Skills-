
Q2. Find all the roots of a quadratic equation.


#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, c, d;
    cout << "Enter a, b and c: ";
    cin >> a >> b >> c;

    d = b * b - 4 * a * c;

    if (d > 0) {
        cout << "Roots: "
             << (-b + sqrt(d)) / (2 * a) << " and "
             << (-b - sqrt(d)) / (2 * a);
    } else if (d == 0) {
        cout << "Equal roots: " << -b / (2 * a);
    } else {
        cout << "Roots are imaginary";
    }

    return 0;
}
