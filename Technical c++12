Q12. Find the longest word in a string.

#include <iostream>
#include <sstream>
#include <string>
using namespace std;

int main() {
    string s, word, longest = "";
    cout << "Enter a sentence: ";
    getline(cin, s);

    stringstream ss(s);

    while (ss >> word) {
        if (word.length() > longest.length())
            longest = word;
    }

    cout << "Longest word = " << longest;
    return 0;
}
