Q11. Replace each letter in a string with the next alphabet.

#include <iostream>
#include <string>
using namespace std;

int main() {
    string s;
    cout << "Enter a string: ";
    getline(cin, s);

    for (int i = 0; i < s.length(); i++) {
        if (s[i] >= 'a' && s[i] < 'z')
            s[i]++;
        else if (s[i] == 'z')
            s[i] = 'a';
        else if (s[i] >= 'A' && s[i] < 'Z')
            s[i]++;
        else if (s[i] == 'Z')
            s[i] = 'A';
    }

    cout << "New string = " << s;
    return 0;
}
