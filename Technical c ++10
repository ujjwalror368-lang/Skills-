Q10. Write a C++ program to reverse a given string

#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

int main() {
    string s;
    cout << "Enter a string: ";
    getline(cin, s);

    reverse(s.begin(), s.end());

    cout << "Reversed string = " << s;
    return 0;
}
