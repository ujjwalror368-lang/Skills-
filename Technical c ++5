Q5. Perform array operations using a switch statement.


#include <iostream>
using namespace std;

int main() {
    int a[5], b[5], choice;
    int largest, smallest, sum = 0;

    cout << "Enter 5 elements of first array: ";
    for (int i = 0; i < 5; i++)
        cin >> a[i];

    cout << "Enter 5 elements of second array: ";
    for (int i = 0; i < 5; i++)
        cin >> b[i];

    cout << "1. Add arrays\n2. Subtract arrays\n";
    cout << "3. Multiply arrays\n4. Largest and Smallest\n";
    cout << "5. Average of first array\n";
    cout << "Enter choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            for (int i = 0; i < 5; i++)
                cout << a[i] + b[i] << " ";
            break;

        case 2:
            for (int i = 0; i < 5; i++)
                cout << a[i] - b[i] << " ";
            break;

        case 3:
            for (int i = 0; i < 5; i++)
                cout << a[i] * b[i] << " ";
            break;

        case 4:
            largest = smallest = a[0];
            for (int i = 1; i < 5; i++) {
                if (a[i] > largest) largest = a[i];
                if (a[i] < smallest) smallest = a[i];
            }
            cout << "Largest = " << largest << endl;
            cout << "Smallest = " << smallest;
            break;

        case 5:
            for (int i = 0; i < 5; i++)
                sum += a[i];
            cout << "Average = " << sum / 5.0;
            break;

        default:
            cout << "Invalid choice";
    }

    return 0;
}
